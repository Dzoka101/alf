# === Генерация контента ===
# Ключ Anthropic API (console.anthropic.com). Без ключа работает офлайн-набор постов (--offline).
ANTHROPIC_API_KEY=

# === Instagram (Graph API) ===
# Нужен бизнес/креатор-аккаунт Instagram, привязанный к странице Facebook.
# Токен: developers.facebook.com -> приложение -> Instagram Graph API -> долгоживущий токен
# с правами instagram_basic, instagram_content_publish, pages_read_engagement.
IG_ACCESS_TOKEN=
# ID Instagram-аккаунта (не username): GET /me/accounts -> page -> instagram_business_account
IG_USER_ID=

# Публичный базовый URL репозитория для картинок (Instagram скачивает по URL).
# Для публичного GitHub-репозитория: https://raw.githubusercontent.com/<owner>/<repo>/<ветка>
MEDIA_BASE_URL=

# === Telegram ===
# Бот от @BotFather, добавленный администратором в канал.
TELEGRAM_BOT_TOKEN=
# @имя_канала или числовой chat_id
TELEGRAM_CHAT_ID=

# === VK ===
# Токен пользователя-админа сообщества со scope photos,wall (или ключ доступа сообщества + user token для загрузки фото).
VK_ACCESS_TOKEN=
# Числовой ID сообщества без минуса
VK_GROUP_ID=
